# ===========================================
# Rural Emergency Assistance Platform
# Environment Configuration
# ===========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (optional - app works without it using in-memory storage)
MONGODB_URI=mongodb://localhost:27017/rural-emergency

# AI Service - Google Gemini API
# Get your API key from: https://aistudio.google.com/apikey
# If not set, the app falls back to keyword-based emergency categorization
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Emergency Number (default: India's 112)
EMERGENCY_NUMBER=112
